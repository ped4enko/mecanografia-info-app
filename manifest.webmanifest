{
  "id": "/ms-app/",
  "name": "Mecanografía Info",
  "short_name": "Mecanografía",
  "description": "Practica mecanografía en español gratis y sin conexión: tildes, ñ, ¿ ¡, test de velocidad de 1 minuto, modo niños, modo sin tildes y estadísticas de progreso.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f4ee",
  "theme_color": "#0f6b5c",
  "categories": ["education", "productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "windows",
      "url": "https://apps.microsoft.com/detail/9mtgzl7g21vp",
      "id": "9MTGZL7G21VP"
    },
    {
      "platform": "chrome_web_store",
      "url": "https://chromewebstore.google.com/detail/mecanograf%C3%ADa-test-de-velo/kjafeldbajjbpnjpjdpiahmccpkgmmgb",
      "id": "kjafeldbajjbpnjpjdpiahmccpkgmmgb"
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [".txt"]
      },
      "icons": [
        { "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ],
  "icons": [
    { "src": "icons/icon-48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-72.png", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/wide-practice.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Práctica con teclado de colores por dedo" },
    { "src": "screenshots/wide-stats.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Estadísticas de progreso" },
    { "src": "screenshots/narrow-practice.png", "sizes": "540x1080", "type": "image/png", "form_factor": "narrow", "label": "Práctica en pantalla pequeña" }
  ],
  "shortcuts": [
    { "name": "Test de 1 minuto", "short_name": "Test", "url": "./?mode=test", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Mecanografía para niños", "short_name": "Niños", "url": "./?mode=kids", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Estadísticas", "short_name": "Estadísticas", "url": "./?mode=stats", "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }] }
  ]
}
